# 构建上下文只保留编译所需：前端源码（web/）+ Go 源码 + skills/。
# 其余一律排除——既缩小上下文上传，也避免老产物（web/out、server/webui/dist、
# 本地二进制）覆盖构建阶段刚生成的对应文件。

# 版本控制 / CI
.git
.github

# Docker 自身文件（避免 COPY . . 反复触发缓存失效）
Dockerfile
docker-compose.yml
.dockerignore
.env
.env.*
.env.example

# 本地 / 机密文件：绝不进镜像，凭据不能被打进镜像缓存
config.json
data/
.local/
jwt.key
*.log

# 构建产物（镜像内由各构建阶段重新生成）
web/node_modules/
web/.next/
web/out/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
server/webui/dist/
dist/
artex
artex.exe
artex.new
artex.new.sha256
artex.old
artex.failed
artex.upgrade.json

# 文档与展示资源（运行时用不到；LICENSE 保留，镜像内需保留协议文本）
README.md
CHANGELOG.md
logo.png
screenshots/
docs/

# 开发工具本地状态
.idea/
.vscode/
.claude/
.playwright-mcp/
.playwright-cli/
bench/

# 本机脚本（Windows / 个人开发用）
install.bat
start.bat
startt.bat
stop.bat
